# Copy to .env.local (or .env) and fill in. Vite only exposes vars prefixed VITE_.

# Base URL of the booking API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Stripe PUBLISHABLE key (starts with pk_test_...), safe to expose in the
# browser. Never put the secret key here — that belongs only in the API's .env.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
